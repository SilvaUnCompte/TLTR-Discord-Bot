# Copy this file to .env and fill in your own values.


# ========== DISCORD ==========

# Bot token from the Discord Developer Portal.
DISCORD_TOKEN=your_bot_token_here

# Application ID, from the "General Information" page.
CLIENT_ID=your_client_id_here

# Optional. When set, slash commands are deployed to this guild only, which is
# instant. Leave empty to deploy globally (up to one hour of propagation).
GUILD_ID=


# ========== AI ==========

# Groq API key, from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# Character budget sent to the model. Keeps a request inside the free tier.
TLTR_CHAR_BUDGET=12000
ASK_CHAR_BUDGET=6000


# ========== SPEECH TO TEXT ==========

# Path to the Google Cloud service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=google-credentials.json

# Primary language of the transcription.
STT_LANGUAGE=fr-FR

# Milliseconds before a speech-to-text request is aborted.
STT_TIMEOUT=15000

# Noise gate applied before transcription (lower = more sensitive).
STT_NOISE_GATE_THRESHOLD=500


# ========== VOICE CAPTURE ==========

# Minimum size of an audio buffer to be considered, in bytes.
BUFFER_THRESHOLD=5000

# Minimum speech duration in milliseconds, to avoid false triggers.
MIN_SPEECH_DURATION=800

# Minimum RMS amplitude that separates speech from background noise.
MIN_VOLUME_THRESHOLD=500

# Silence in milliseconds before a recording is considered finished.
SILENCE_DURATION=1500

# Hard cap on a single recording, in milliseconds.
MAX_RECORDING_DURATION=30000

# The copilot leaves the voice channel after this long without speech, in ms.
COPILOT_IDLE_TIMEOUT=600000


# ========== LOGGING ==========

# Console verbosity: DEBUG, INFO, WARN, ERROR or FATAL.
LOG_LEVEL=INFO

# Number of days log files are kept.
MAX_LOG_DAYS=30

# Rotate a log file once it exceeds this size, in MB. 0 disables rotation.
MAX_LOG_FILE_SIZE=10

# Very noisy Discord gateway events, off by default.
LOG_DISCORD_WARNINGS=false
LOG_DISCORD_DEBUG=false
